# Non-secret Discord bot configuration. Installed as /etc/palworld/discord.env.
PALWORLD_DISCORD_GUILD_ID=
PALWORLD_DISCORD_METRICS_FILE=/var/lib/palworld-observer/palworld.prom
PALWORLD_DISCORD_METRICS_MAX_AGE_SECONDS=30
PALWORLD_DISCORD_PLAYER_SNAPSHOT_FILE=/var/lib/palworld-observer/players.snapshot
PALWORLD_DISCORD_PLAYER_SNAPSHOT_MAX_AGE_SECONDS=30
PALWORLD_DISCORD_PLAYER_DIRECTORY_FILE=/var/lib/palworld-observer/player-directory.snapshot
PALWORLD_DISCORD_PLAYER_WATCH_INTERVAL_SECONDS=2
PALWORLD_DISCORD_COMMAND_TIMEOUT_SECONDS=840
PALWORLD_DISCORD_ESCAPE_TIMEOUT_SECONDS=30
