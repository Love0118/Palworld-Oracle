# Non-secret Discord bot configuration. Installed as /etc/palworld/discord.env.
PALWORLD_DISCORD_GUILD_ID=
PALWORLD_DISCORD_CHANNEL_ID=
PALWORLD_DISCORD_ADMIN_ROLE_IDS=
PALWORLD_DISCORD_METRICS_FILE=/var/lib/palworld-observer/palworld.prom
PALWORLD_DISCORD_METRICS_MAX_AGE_SECONDS=30
PALWORLD_DISCORD_COMMAND_TIMEOUT_SECONDS=840
