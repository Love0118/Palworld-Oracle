#!/usr/bin/env bash
set -Eeuo pipefail

if [[ -d /usr/local/lib/palworld-oracle/scripts ]]; then
  SCRIPT_DIR=/usr/local/lib/palworld-oracle/scripts
else
  SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
fi

usage() {
  cat <<'EOF'
Usage: palworldctl <command> [arguments]

Commands:
  start|stop|restart|status   Control palworld.service.
  logs                       Follow the service journal.
  metrics                    Print REST metrics JSON.
  backup                     Create a backup through systemd.
  update                     Stage and activate an update.
  configure [options]        Configure REST/admin password and basic settings.
  profile <show|apply>       Show or atomically apply the ARM-balanced profile.
  doctor                     Validate the host and installation.
  release                    Print the active immutable release.
  settings                   Print the live PalWorldSettings.ini path.
EOF
}

command_name="${1:-}"
if (( $# > 0 )); then
  shift
fi

case "$command_name" in
  start|stop|restart)
    systemctl "$command_name" palworld.service
    ;;
  status)
    systemctl status --no-pager palworld.service
    ;;
  logs)
    journalctl --unit palworld.service --follow
    ;;
  metrics)
    "$SCRIPT_DIR/rest.sh" metrics
    ;;
  backup)
    systemctl start palworld-backup.service
    ;;
  update)
    systemctl start palworld-update.service
    systemctl status --no-pager palworld-update.service || true
    ;;
  configure)
    "$SCRIPT_DIR/configure-server.sh" "$@"
    ;;
  profile)
    "$SCRIPT_DIR/apply-server-profile.sh" "$@"
    ;;
  doctor)
    "$SCRIPT_DIR/doctor.sh"
    ;;
  release)
    readlink -f /opt/palworld/current
    ;;
  settings)
    printf '/var/lib/palworld/Saved/Config/LinuxServer/PalWorldSettings.ini\n'
    ;;
  -h|--help|help|'')
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
