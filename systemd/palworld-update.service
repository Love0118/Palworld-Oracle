[Unit]
Description=Stage and atomically activate a Palworld update
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/palworld/palworld.env
ExecStart=/usr/local/lib/palworld-oracle/scripts/maintenance-update.sh
TimeoutStartSec=infinity
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ReadWritePaths=/opt/palworld /var/lib/palworld /var/lib/palworld-updater /var/lib/palworld-admin /var/cache/palworld
